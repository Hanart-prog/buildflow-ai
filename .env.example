# Free key from https://console.groq.com/keys. Used first if set.
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Set to true to run the whole pipeline on canned responses, no API key needed
DEMO_MODE=false
PORT=3001
# Optional extra password in front of the whole app, such as during a private beta. Share links stay open.
APP_PASSWORD=
